<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<deployment
    xmlns="http://xml.apache.org/axis/wsdd/"
    xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">

  <!-- Services from AndroidWebServiceService WSDL service -->

  <service name="AndroidWebService" provider="java:RPC" style="wrapped" use="literal">
      <parameter name="wsdlTargetNamespace" value="http://test"/>
      <parameter name="wsdlServiceElement" value="AndroidWebServiceService"/>
      <parameter name="schemaQualified" value="http://test"/>
      <parameter name="wsdlServicePort" value="AndroidWebService"/>
      <parameter name="className" value="test.AndroidWebServiceSoapBindingImpl"/>
      <parameter name="wsdlPortType" value="AndroidWebService"/>
      <parameter name="typeMappingVersion" value="1.2"/>
      <operation name="squire" qname="operNS:squire" xmlns:operNS="http://test" returnQName="retNS:squireReturn" xmlns:retNS="http://test" returnType="rtns:int" xmlns:rtns="http://www.w3.org/2001/XMLSchema" soapAction="" >
        <parameter qname="pns:a" xmlns:pns="http://test" type="tns:int" xmlns:tns="http://www.w3.org/2001/XMLSchema"/>
      </operation>
      <parameter name="allowedMethods" value="squire"/>

  </service>
</deployment>
